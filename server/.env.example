# Backend Environment Variables
# Provide these in the Render/Railway dashboard

PORT=5001
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/your-db?retryWrites=true&w=majority"
JWT_SECRET="your_secure_jwt_secret_here"
EMAIL_USER="your-email@hotmail.com"
EMAIL_PASS="your-email-password"

# URL of your deployed frontend (e.g. Vercel URL)
CLIENT_URL="https://your-frontend.vercel.app"
